[Measures].[Заказ Сумма Ручной Скидки] / ([Measures].[Заказ Сумма] + [Measures].[Заказ Сумма Автоматической Скидки] + [Measures].[Заказ Сумма Ручной Скидки])), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1  ; 
