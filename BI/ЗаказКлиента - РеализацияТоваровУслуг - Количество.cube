      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[СредняяСумма]
 AS IIF([Measures].[КоличествоЗаказов] = 0, NULL, [Measures].[СуммаПоЗаказам] / [Measures].[КоличествоЗаказов]), 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Средняя Реализация]
 AS IIF([Measures].[Отгруженных] = 0, NULL, [Measures].[СуммаПоРеализациям] / [Measures].[Отгруженных]), 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
