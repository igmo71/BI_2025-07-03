      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;   
CREATE MEMBER CURRENTCUBE.[Measures].[Запас в днях]
 AS IIF([Measures].[Predicts Вес] = 0, 365,[Measures].[Остатки Вес]/[Measures].[Predicts Вес] * 28), 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Запас в днях с учетом поступлений]
 AS IIF([Measures].[Predicts Вес] = 0, 365,[Measures].[Прогноз Вес]/[Measures].[Predicts Вес] * 28), 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
