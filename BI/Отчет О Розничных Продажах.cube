  <MdxScripts>
    <MdxScript dwd:design-time-name="3a16f6cb-ab83-4119-a8c9-066012f2f195">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2023-11-28T15:34:12.37Z</CreatedTimestamp>
      <LastSchemaUpdate>2025-06-10T06:14:23.406667Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Процент Ручной Скидки]
 AS IIF(([Measures].[Сумма] + [Measures].[Measures].[Сумма Ручной Скидки]) = 0, NULL,
[Measures].[Сумма Ручной Скидки] / ([Measures].[Сумма] + [Measures].[Measures].[Сумма Ручной Скидки])), 
FORMAT_STRING = "#,##0%;-#,##0%", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
