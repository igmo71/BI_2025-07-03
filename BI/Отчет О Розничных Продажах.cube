    <SilenceOverrideInterval>-PT1S</SilenceOverrideInterval>
    <ForceRebuildInterval>-PT1S</ForceRebuildInterval>
    <Source xsi:type="ProactiveCachingInheritedBinding" dwd:design-time-name="e2aaf435-2356-4d48-86a8-fbf72dfa2bb1" />
  </ProactiveCaching>
