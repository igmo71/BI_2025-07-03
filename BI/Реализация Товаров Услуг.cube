  <MdxScripts>
    <MdxScript>
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2023-11-17T10:22:41.153333Z</CreatedTimestamp>
      <LastSchemaUpdate>2025-06-10T06:14:23.766667Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Процент Автоматической Скидки]
 AS IIF(([Measures].[Сумма] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки]) = 0, NULL,
[Measures].[Сумма Автоматической Скидки] / ([Measures].[Сумма] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки])), 
FORMAT_STRING = "#,##0%;-#,##0%", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Процент Ручной Скидки]
 AS IIF(([Measures].[Сумма] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки]) = 0, NULL,
[Measures].[Сумма Ручной Скидки] / ([Measures].[Сумма] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки])), 
FORMAT_STRING = "#,##0%;-#,##0%", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
