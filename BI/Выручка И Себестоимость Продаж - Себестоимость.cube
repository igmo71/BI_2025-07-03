  <Source dwd:design-time-name="db745f62-eefc-4b01-b655-a7eb5738dc75">
    <DataSourceViewID>WH-dev</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="9f8827e6-0cad-4095-a007-0e0ec68016d3">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2024-09-13T08:39:52.853333Z</CreatedTimestamp>
      <LastSchemaUpdate>2025-06-10T06:14:25.783333Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;       
CREATE MEMBER CURRENTCUBE.[Measures].[Маржа]
 AS IIF([Measures].[Сумма Выручки] &gt; 0, 
([Measures].[Сумма Выручки] - [Measures].[Себестоимость]) / [Measures].[Сумма Выручки], null), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].[Маржа по текущему курсу]
 AS IIF([Measures].[Сумма Выручки] &gt; 0, 
([Measures].[Сумма Выручки] / [Measures].[Текущий курс] - [Measures].[Себестоимость USD]) / ([Measures].[Сумма Выручки] / [Measures].[Текущий курс]), null), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1  ;    
CREATE MEMBER CURRENTCUBE.[Measures].[Маржа по курсу на момент продажи]
 AS IIF([Measures].[Сумма Выручки] &gt; 0, 
([Measures].[Сумма Выручки] / [Measures].[USD] - [Measures].[Себестоимость USD]) / ([Measures].[Сумма Выручки] / [Measures].[USD]), null), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1  ;       
CREATE MEMBER CURRENTCUBE.[Measures].[Прибыль]
 AS IIF([Measures].[Сумма Выручки] &gt; 0, [Measures].[Маржа] * [Measures].[Сумма Выручки], null), 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[Прибыль, USD]
 AS [Measures].[Прибыль] / [Measures].[USD], 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[Себестоимость за кг, р]
 AS [Measures].[Себестоимость] / [Measures].[Вес], 
FORMAT_STRING = "#,##0.0;-#,##0.0", 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[Себестоимость за кг, USD]
 AS [Measures].[Себестоимость USD] / [Measures].[Вес], 
FORMAT_STRING = "#,##0.0;-#,##0.0", 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Текущий курс]
 AS (
        Tail(
            NonEmpty(
                        [Календарь].[Г-ММ-Д].members,
                        [Measures].[USD]
                    )
            ).ITEM(0),[Measures].[USD]
    ), 
VISIBLE = 0;     
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка]
 AS IIF([Measures].[Себестоимость] &gt; 0, 
([Measures].[Сумма Выручки] - [Measures].[Себестоимость]) / [Measures].[Себестоимость], null), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка по текущему курсу]
 AS IIF([Measures].[Себестоимость USD] &gt; 0, 
([Measures].[Сумма Выручки] / [Measures].[Текущий курс] - [Measures].[Себестоимость USD]) / [Measures].[Себестоимость USD], null), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка по курсу на момент продажи]
 AS IIF([Measures].[Себестоимость USD] &gt; 0, 
([Measures].[Сумма Выручки] / [Measures].[USD] - [Measures].[Себестоимость USD]) / [Measures].[Себестоимость USD], null), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
