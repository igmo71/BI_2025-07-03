  <MdxScripts>
    <MdxScript>
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2025-05-27T08:36:13.316667Z</CreatedTimestamp>
      <LastSchemaUpdate>2025-06-10T06:14:27.236667Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;     
CREATE MEMBER CURRENTCUBE.[Measures].[Средний запас - дни]
 AS AVG(
   LASTPERIODS(90, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
   [Measures].[Остатки на конец - Вес] ), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 0; 
CREATE MEMBER CURRENTCUBE.[Measures].[Средний запас - месяцы]
 AS AVG(
   LASTPERIODS(3, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
   [Measures].[Остатки на конец - Вес] ), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 0; 
CREATE MEMBER CURRENTCUBE.[Measures].[Средний запас - годы]
 AS AVG(
   LASTPERIODS(1, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
   [Measures].[Остатки на конец - Вес] ), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 0; 

CREATE MEMBER CURRENTCUBE.[Measures].[Средний запас] AS
    CASE
        WHEN [Календарь].[Г-ММ-Д].CURRENTMEMBER.LEVEL.ORDINAL &lt;= 1
            THEN [Measures].[Средний запас - годы]
        WHEN [Календарь].[Г-ММ-Д].CURRENTMEMBER.LEVEL.ORDINAL  = 2
            THEN [Measures].[Средний запас - месяцы]
        ELSE [Measures].[Средний запас - дни] 
    END,
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[Скользящее среднее продаж - дни, кг]
 AS AVG(
   LASTPERIODS(90, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
   [Measures].[Выручка - Вес]), 
FORMAT_STRING = "#,##0.00;-#,##0.00",  
VISIBLE = 0  ;
CREATE MEMBER CURRENTCUBE.[Measures].[Скользящее среднее продаж - месяцы, кг]
 AS AVG(
   LASTPERIODS(3, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
   [Measures].[Выручка - Вес]), 
FORMAT_STRING = "#,##0.00;-#,##0.00",  
VISIBLE = 0  ;
CREATE MEMBER CURRENTCUBE.[Measures].[Скользящее среднее продаж - годы, кг]
 AS AVG(
   LASTPERIODS(1, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
   [Measures].[Выручка - Вес]), 
FORMAT_STRING = "#,##0.00;-#,##0.00",  
VISIBLE = 0  ; 

CREATE MEMBER CURRENTCUBE.[Measures].[Скользящее среднее] AS
    CASE
        WHEN [Календарь].[Г-ММ-Д].CURRENTMEMBER.LEVEL.ORDINAL &lt;= 1
            THEN [Measures].[Скользящее среднее продаж - годы, кг]
        WHEN [Календарь].[Г-ММ-Д].CURRENTMEMBER.LEVEL.ORDINAL  = 2
            THEN [Measures].[Скользящее среднее продаж - месяцы, кг]
        ELSE [Measures].[Скользящее среднее продаж - дни, кг] 
    END,
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[Оборачиваемость - дни]
 AS IIF(
        SUM(
            LASTPERIODS(30, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
            [Measures].[Выручка - Вес]) &gt; 0,
            ([Measures].[Средний запас] * 30) / 
                SUM(
                    LASTPERIODS(30, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
                    [Measures].[Выручка - Вес]), 
            9999
    ),
FORMAT_STRING = "#,##0.00;-#,##0.00",  
VISIBLE = 0  ;
CREATE MEMBER CURRENTCUBE.[Measures].[Оборачиваемость - месяцы]
 AS IIF(
        SUM(
            LASTPERIODS(3, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
            [Measures].[Выручка - Вес]) &gt; 0,
            ([Measures].[Средний запас] * 3) / 
                SUM(
                    LASTPERIODS(3, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
                    [Measures].[Выручка - Вес]), 
            9999
    ),
FORMAT_STRING = "#,##0.00;-#,##0.00",  
VISIBLE = 0  ;
CREATE MEMBER CURRENTCUBE.[Measures].[Оборачиваемость - годы]
 AS IIF(
        SUM(
            LASTPERIODS(1, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
            [Measures].[Выручка - Вес]) &gt; 0,
            ([Measures].[Средний запас] * 2) / 
                SUM(
                    LASTPERIODS(1, [Календарь].[Г-ММ-Д].CURRENTMEMBER),  
                    [Measures].[Выручка - Вес]), 
            9999
    ), 
FORMAT_STRING = "#,##0.00;-#,##0.00",  
VISIBLE = 0  ; 

CREATE MEMBER CURRENTCUBE.[Measures].[Оборачиваемость - служебная] AS
    CASE
        WHEN [Календарь].[Г-ММ-Д].CURRENTMEMBER.LEVEL.ORDINAL &lt;= 1
            THEN [Measures].[Оборачиваемость - годы]
        WHEN [Календарь].[Г-ММ-Д].CURRENTMEMBER.LEVEL.ORDINAL  = 2
            THEN [Measures].[Оборачиваемость - месяцы]
        ELSE [Measures].[Оборачиваемость - дни] 
    END,
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 0; 

CREATE MEMBER CURRENTCUBE.[Measures].[Оборачиваемость] AS
    IIF([Measures].[Оборачиваемость - служебная] &gt;= 9999 AND NOT [Measures].[Остатки на конец - Вес] &gt; 0,
            NULL, 
            [Measures].[Оборачиваемость - служебная]
        ),
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
