  <MdxScripts>
    <MdxScript>
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2023-11-09T14:01:59.253333Z</CreatedTimestamp>
      <LastSchemaUpdate>2025-06-10T06:14:21.69Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;            
CREATE MEMBER CURRENTCUBE.[Measures].[Себестоимость]
 AS [Measures].[Стоимость] + [Measures].[Доп Расходы], 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1;             
CREATE MEMBER CURRENTCUBE.[Measures].[Себестоимость без НДС]
 AS [Measures].[Стоимость Без НДС] + [Measures].[Доп Расходы Без НДС], 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1;              
CREATE MEMBER CURRENTCUBE.[Measures].[Прибыль]
 AS [Measures].[Сумма Выручки] - [Measures].[Стоимость] - [Measures].[Доп Расходы], 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1;             
CREATE MEMBER CURRENTCUBE.[Measures].[Прибыль без НДС]
 AS [Measures].[Сумма Выручки Без НДС] - [Measures].[Стоимость Без НДС] - [Measures].[Доп Расходы Без НДС], 
FORMAT_STRING = "#,##0;-#,##0", 
VISIBLE = 1;              
CREATE MEMBER CURRENTCUBE.[Measures].[Маржа]
 AS IIF([Measures].[Сумма Выручки] = 0, NULL, ([Measures].[Сумма Выручки] - [Measures].[Стоимость] - [Measures].[Доп Расходы]) / [Measures].[Сумма Выручки]), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Маржа без Скидок]
 AS IIF([Measures].[Сумма Выручки] = 0, NULL, ([Measures].[Сумма Выручки] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки] - [Measures].[Стоимость] - [Measures].[Доп Расходы]) / [Measures].[Сумма Выручки]), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Маржа без НДС]
 AS IIF([Measures].[Сумма Выручки Без НДС] = 0, NULL, ([Measures].[Сумма Выручки Без НДС] - [Measures].[Стоимость Без НДС] - [Measures].[Доп Расходы Без НДС]) / [Measures].[Сумма Выручки Без НДС]), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1  ;         
CREATE MEMBER CURRENTCUBE.[Measures].[Процент Автоматической Скидки]
 AS IIF(([Measures].[Сумма Выручки] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки]) = 0, NULL,
 [Measures].[Сумма Автоматической Скидки] / ([Measures].[Сумма Выручки] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки])), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1  ;         
CREATE MEMBER CURRENTCUBE.[Measures].[Процент Ручной Скидки]
 AS IIF(([Measures].[Сумма Выручки] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки]) = 0, NULL,
 [Measures].[Сумма Ручной Скидки] / ([Measures].[Сумма Выручки] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки])), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1  ;         
CREATE MEMBER CURRENTCUBE.[Measures].[Процент Общей Скидки]
 AS IIF(([Measures].[Сумма Выручки] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки]) = 0, NULL,
 ([Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки]) / ([Measures].[Сумма Выручки] + [Measures].[Сумма Автоматической Скидки] + [Measures].[Сумма Ручной Скидки])), 
FORMAT_STRING = "#,##0.0%;-#,##0.0%", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
